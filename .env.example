# Databricks Xray Proxy 环境变量配置
# 复制此文件为 .env 并填入您的配置

# ================================
# Xray 配置
# ================================

# Xray 版本（默认: latest）
XRAY_VERSION=latest

# Xray 安装目录
XRAY_INSTALL_DIR=/usr/local/bin

# Xray 配置目录
XRAY_CONFIG_DIR=/etc/xray

# Xray 日志目录
XRAY_LOG_DIR=/var/log/xray

# VMess 端口（默认: 10809）
XRAY_PORT=10809

# SOCKS5 端口（默认: 1080）
XRAY_SOCKS_PORT=1080

# VMess UUID（留空自动生成）
# 可以通过以下命令生成: cat /proc/sys/kernel/random/uuid
XRAY_UUID=

# ================================
# Cloudflare Tunnel 配置
# ================================

# Cloudflare API Token
# 创建地址: https://dash.cloudflare.com/profile/api-tokens
# 需要权限:
#   - Account.Cloudflare Tunnel: Edit
#   - Zone.DNS: Edit
CF_TOKEN=

# Cloudflare Account ID（可选）
# 在 Cloudflare Dashboard 右侧边栏可以找到
CF_ACCOUNT_ID=

# Tunnel 名称
TUNNEL_NAME=databricks-xray-proxy

# Cloudflared 配置目录
CLOUDFLARED_DIR=/etc/cloudflared

# ================================
# Databricks 特定配置
# ================================

# 是否在 Databricks Init Script 中运行（yes/no）
DATABRICKS_INIT=no

# Databricks Workspace URL（可选）
DATABRICKS_WORKSPACE_URL=

# Databricks Cluster ID（可选）
DATABRICKS_CLUSTER_ID=

# ================================
# 高级配置
# ================================

# 是否启用日志（yes/no）
ENABLE_LOGGING=yes

# 日志级别（debug/info/warning/error）
LOG_LEVEL=warning

# 是否启用广告拦截（yes/no）
ENABLE_AD_BLOCK=yes

# 是否启用 UDP（yes/no）
ENABLE_UDP=yes

# 连接超时（秒）
CONNECTION_TIMEOUT=30

# 是否自动更新（yes/no）
AUTO_UPDATE=no
